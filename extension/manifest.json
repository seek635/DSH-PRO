{
  "manifest_version": 3,
  "name": "DSH PRO",
  "version": "0.1.0",
  "description": "DeepSeek 网页版本地工具桥：文件读写/搜索/safe bash/git 查询，并可把计划交给 DeepSeek Harness (dsh headless) 执行。",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["selectors.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
